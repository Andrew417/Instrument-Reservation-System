# =========================================================================
# Database Configuration
# =========================================================================
# Production / Neon PostgreSQL Connection String (used on Vercel):
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Local / Cloud SQL discrete connection variables (used in local dev container):
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="postgres"
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# =========================================================================
# Super Admin Seed Credentials (used for initial DB setup & CLI seeding)
# =========================================================================
SUPER_ADMIN_EMAIL="admin@church.org"
SUPER_ADMIN_PHONE="01000000000"
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_PASSWORD="StrongPassword123!"

# =========================================================================
# Email & Notification Services
