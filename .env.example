# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# (Optional) Real SMS Gateway Configuration for Phone OTP Dispatch
# If omitted, system runs in transparent TEST MODE with UI simulation & server logging
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# PostgreSQL / Vercel serverless database configuration
# Preferred: set DATABASE_URL for serverless / pooled connections.
# The legacy SQL_* variables still work for local development.
DATABASE_URL="postgresql://username:password@host:5432/database_name"
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="postgres"
SQL_DB_NAME="instrument_reservation"

# App runtime settings
PORT="3000"
NODE_ENV="development"
APP_ENV="development"
